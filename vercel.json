{
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/process", "destination": "/api/process.php" },
    { "source": "/preview", "destination": "/api/preview.php" },
    { "source": "/download", "destination": "/api/download.php" },
    { "source": "/(.*\\.php)$", "destination": "/api/$1" }
  ],
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
