{
  "builds": [
    {
      "src": "public/index.php",
      "use": "vercel-php@0.7.4"
    },
    {
      "src": "public/process.php",
      "use": "vercel-php@0.7.4"
    },
    {
      "src": "public/preview.php",
      "use": "vercel-php@0.7.4"
    },
    {
      "src": "public/download.php",
      "use": "vercel-php@0.7.4"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/", "dest": "/public/index.php" },
    { "src": "/process", "dest": "/public/process.php" },
    { "src": "/preview", "dest": "/public/preview.php" },
    { "src": "/download", "dest": "/public/download.php" },
    { "src": "/(.*\\.php)$", "dest": "/public/$1" }
  ],
  "outputDirectory": "public",
  "env": {
    "VERCEL_PHP_VERSION": "8.2"
  }
}
